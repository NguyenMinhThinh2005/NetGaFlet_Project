{
  "compilerOptions": {
    // Module system — CommonJS matches package.json "type": "commonjs"
    // and is what ts-node uses by default (no --esm flag needed)
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    // Node.js types
    "types": [
      "node"
    ],
    "lib": [
      "es2020"
    ],
    // Interop — required for default imports from CJS packages (express, dotenv…)
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // Output (for reference; ts-node compiles in-memory)
    "sourceMap": true,
    "declaration": false,
    // Strict checks
    "strict": true,
    "skipLibCheck": true,
    // Relaxed options that caused false positives in Express controllers
    // (exactOptionalPropertyTypes conflicts with Express req/res types)
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}